# Salin ke htdocs/.env lalu isi bagian yang bertanda <...>.
# Nilai rahasia TIDAK ada di sini — berkas ini aman untuk disimpan di repositori.
#
# Cara memperoleh APP_KEY: jalankan `php artisan key:generate --show` di mesin
# lokal, lalu tempel hasilnya. Jangan pernah menjalankan artisan di server:
# InfinityFree tidak punya SSH.

APP_NAME=ANFALM
APP_ENV=production
APP_KEY=<tempel-hasil-key-generate-show>
APP_DEBUG=false
APP_URL=https://<domain-anda>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Tidak ada rotasi file bawaan, jadi pakai daily supaya log tak tumbuh tanpa
# batas. Periksa storage/logs/laravel.log lewat File Manager bila ada keluhan.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning

# Nama database, username, dan host persis seperti yang tertera di panel
# InfinityFree (semuanya berprefix if0_). Port 3306.
DB_CONNECTION=mysql
DB_HOST=<host-database-infinityfree>
DB_PORT=3306
DB_DATABASE=<if0_xxxxx_database>
DB_USERNAME=<if0_xxxxx_username>
DB_PASSWORD=<password-database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan setelah SSL terpasang dan situs terbuka lewat https:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Tidak ada proses latar di InfinityFree (tanpa SSH, tanpa cron, tanpa worker),
# jadi antrean harus dijalankan langsung di dalam permintaan.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# InfinityFree mematikan mail() pada paket gratis.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pengaman batas waktu: hosting mematikan permintaan yang terlalu lama, sedangkan
# satu part berisi 12 soal yang menunggu jawaban Gemini. Batasi jumlah model
# yang dicoba dan tungguan tiap percobaan supaya generate tidak terputus.
GEMINI_API_KEY=<kunci-gemini>
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELS=gemini-3.5-flash,gemini-2.0-flash
GEMINI_TIMEOUT=45

VITE_APP_NAME="${APP_NAME}"
